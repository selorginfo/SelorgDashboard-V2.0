# Mock data is OFF by default so the dashboard always talks to the real selorg-service backend.
# Set VITE_USE_MOCKS=true ONLY for offline UI work — it serves in-memory fixtures, so every
# create/edit/delete looks successful while persisting nothing.
# Mocks are force-disabled in production builds regardless of this value (src/lib/useMocks.ts).
VITE_USE_MOCKS=false

# Backend API base URL — selorg-service runs on port 3333 by default.
VITE_API_URL=http://localhost:3333
